# ------------------------------------------------------------------
# Shodh configuration. Copy to .env and fill in as needed:
#   cp .env.example .env
# .env is git-ignored; never commit real credentials.
# ------------------------------------------------------------------

# ---- Provider selection ----
# LLM_PROVIDER / EMBEDDING_PROVIDER: ollama | lmstudio | openai | azure_openai | gemini
LLM_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama

# ---- CORS (comma-separated frontend origins) ----
CORS_ORIGINS=http://localhost:3000

# ---- Authentication ----
# single_user (default): no auth; everything maps to the built-in local tenant.
# jwt: require a Bearer JWT signed with AUTH_JWT_SECRET.
AUTH_MODE=single_user
AUTH_JWT_SECRET=
AUTH_JWT_ALGORITHM=HS256
AUTH_JWT_EMAIL_CLAIM=email

# ---- Ollama (local) ----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
EMBEDDING_MODEL=nomic-embed-text:v1.5
CREW_LLM_SMALL=qwen2.5:3b
CREW_LLM_LARGE=qwen2.5:7b

# ---- LM Studio (local, OpenAI-compatible) ----
# Start LM Studio's local server, then select a loaded model below.
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_API_KEY=lm-studio
LMSTUDIO_MODEL=qwen2.5-7b-instruct
LMSTUDIO_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5

# ---- OpenAI ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---- Azure OpenAI ----
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2023-05-15
AZURE_DEPLOYMENT_NAME=
AZURE_EMBEDDING_DEPLOYMENT=

# ---- Gemini ----
GEMINI_API_KEY=
GEMINI_MODEL=models/gemini-1.5-flash-latest
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# ---- Relational DB ----
# SQLite by default; use Postgres for a shared/scaled deployment, e.g.
# DATABASE_URL=postgresql+psycopg://shodh:shodh@localhost:5432/shodh
DATABASE_URL=sqlite:///./shodh.db
# Create tables on startup (dev). Set false for managed deployments that apply
# schema with `alembic upgrade head`.
AUTO_CREATE_TABLES=true

# ---- Vector DB (Chroma) ----
VECTOR_DB_PATH=./chroma_db
COLLECTION_NAME=research_papers
# Set VECTOR_DB_HOST to use a Chroma server instead of the embedded store.
VECTOR_DB_HOST=
VECTOR_DB_PORT=8000

# ---- HuggingFace ----
HF_TOKEN=

# ---- Docling ingestion ----
DOCLING_ENABLE_VLM=false
DOCLING_VLM_MODEL=smolvlm-v1
DOCLING_VLM_API_URL=http://localhost:11434/v1/chat/completions
DOCLING_VLM_API_KEY=
DOCLING_VLM_PROMPT=Convert this page to markdown.
